# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment variables
.env
.env.*
!.env.example

# vercel
.vercel

# legacy migration working data: media binaries, extracted content,
# reports, and the temporary admin browser profile stay local.
# Only the scripts and README are committed.
/migration/*
!/migration/README.md
!/migration/scripts/

# typescript
*.tsbuildinfo
next-env.d.ts
